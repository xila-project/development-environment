# Single source of truth for every tool version in the Xila development image.
# The Dockerfile guard, install-tools.sh, the xila-dev wrapper and downstream
# consumers (project CI) all read these pins; do not duplicate versions elsewhere.
XILA_RUST_TOOLCHAIN=1.99.0
XILA_NIGHTLY_TOOLCHAIN=nightly-2026-10-12
NODE_VERSION=24.22.0
CARGO_BINSTALL_VERSION=1.25.3
CARGO_MAKE_VERSION=0.37.24
TRUNK_VERSION=0.21.14
TAPLO_VERSION=0.10.0
CARGO_LLVM_COV_VERSION=0.9.1
SCCACHE_VERSION=0.10.0
# LLVM/Clang used by the build, from apt.llvm.org (the apt suite name is
# llvm-toolchain-noble-<major>, i.e. the first version component).
LLVM_VERSION=21.1.8
